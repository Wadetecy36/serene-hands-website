# Copy to .env.local and fill in once the Supabase project exists.
# Until these are set, the booking flow's identity-verification step
# shows a clear "not available yet" state instead of crashing —
# see src/lib/supabaseClient.ts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Social feed integration (server-side only; never prefix these with VITE_)
# Instagram API with Instagram Login / Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=

# TikTok Display API
TIKTOK_ACCESS_TOKEN=
TIKTOK_PROFILE_URL=https://www.tiktok.com/@serenehandshomecare
# Full OAuth + refresh-token persistence will be added before production.
